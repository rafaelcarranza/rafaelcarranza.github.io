    </svg>
  </a>
  <a class="iconbtn" href="https://orcid.org/0000-0002-7466-4040" title="ORCID" aria-label="ORCID">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="11" />
      <text
        x="12"
        y="16.4"
        text-anchor="middle"
        font-size="11"
        font-weight="600"
        font-family="Public Sans, sans-serif"
        fill="var(--paper)"
      >
